# .gitattributes do knudge — regras para o que o repositório de fato contém.
#
# O `.knudge/` DESTE repositório é local-only (D30/D34): fica no `.git/info/exclude` e não é
# versionado, então não há regras de notas/eventos/cache aqui. O projeto exige newline Unix
# (rustfmt `newline_style = "Unix"`; `install.sh`/`Makefile` quebram com CRLF).

# Normalização global: texto vira LF no índice e no checkout; binários ficam intactos.
* text=auto eol=lf

# Scripts e build: LF explícito (um CRLF quebra `install.sh`/`make`).
*.sh     text eol=lf
Makefile text eol=lf

# Contrato de bytes e dados determinísticos: LF fixo.
*.rs     text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.json   text eol=lf
*.jsonl  text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.tsv    text eol=lf
*.py     text eol=lf
*.txt    text eol=lf
Cargo.lock text eol=lf

# Binários: nunca normalizar (rede de segurança para artefatos futuros).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.gguf binary
*.bin  binary

# Linguist: o projeto é Rust; docs e dados de benchmark não disputam o percentual no GitHub.
*.md        linguist-documentation
wiki/**     linguist-documentation
plan/**     linguist-documentation
.agents/**  linguist-documentation
llms.txt    linguist-documentation
Cargo.lock       linguist-generated
bench/**/*.json  linguist-generated
bench/**/*.tsv   linguist-generated
bench/**/*.lock  linguist-generated
